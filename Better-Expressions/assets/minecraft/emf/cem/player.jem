				{
					"id": "upperbody",
					"invertAxis": "xy",
					"translate": [0, 12, 0],
					"submodels": [
						{
							"id": "head2",
							"invertAxis": "xy",
							"translate": [0, 12, 0]
						}
					]
				}
			],
			"animations": [
{
					"var.shuffle": "clamp(cos(limb_swing * -0.725) * limb_speed, -1, 1)",
					"var.leg": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 0)",
					"var.swing": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 1)",
					"var.is_crouching": "if(is_sneaking, 1, 0)",
					"var.is_on_fire": "if(is_burning && !is_blocking, 1, 0)",
					"var.idle_rate": "-sin(time * 0.075) * 0.3",
					"var.fall_rate": "clamp(height_above_ground * 0.3, 0, 0.8)",
					"var.jumping": "if(height_above_ground > 1 && !is_in_water && !is_on_ground, 1, 0)",
					"var.flightcontrol": "torad(20 * move_forward * limb_speed)"
				},
				{
					"var.ll_tx": "2.1 + if(death_time > 0, -2, 0)",
					"var.ll_ty": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming, left_leg.ty, var.leg * 3.2 + 11.95), var.leg * 3.2 + 11.95 + 0.75), 11.95)",
					"var.ll_tz": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming || fluid_depth_up > 2, if(is_swimming, left_leg.tz, 0), -var.shuffle * 2.25), -var.shuffle * 2.25 + 4.5) + if(death_time > 0, -2, 0), left_leg.tz)",
					"var.rl_tx": "-2.1 + if(death_time > 0, 2, 0)",
					"var.rl_ty": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming, right_leg.ty, -var.leg * 3.2 + 11.95 + limb_speed * -1.6), -var.leg * 3.2 + 11.95 + 0.75), 11.95)",
					"var.rl_tz": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming || fluid_depth_up > 2, if(is_swimming, right_leg.tz, 0), var.shuffle * 2.25), var.shuffle * 2.25 + 4.5) + if(death_time > 0, 2, 0), right_leg.tz)",
					"var.lh_tx": "left_arm.tx + if(death_time > 0, -5, 0)",
					"var.lh_ty": "if(is_on_ground, if(is_gliding, left_arm.ty, var.idle_rate + left_arm.ty + sin(limb_swing) * limb_speed * 0.9), left_arm.ty)",
					"var.lh_tz": "if(limb_speed > 0.05 && !is_swimming, limb_speed * -1.25, left_arm.tz) + if(death_time > 0, -5, 0)",
					"var.rh_tx": "right_arm.tx + if(death_time > 0, 5, 0)",
					"var.rh_ty": "if(is_on_ground, if(is_gliding, right_arm.ty, var.idle_rate + right_arm.ty + sin(limb_swing) * limb_speed * 0.9), right_arm.ty)",
					"var.rh_tz": "if(limb_speed > 0.05 && !is_swimming, limb_speed * -1.25, right_arm.tz) + if(death_time > 0, 5, 0)"
				},
				{
					"var.ll_rx": "if(is_gliding, left_leg.rx, if(is_climbing, torad(-60) + sin(player_pos_y * 2.5) * 0.4, if(is_on_ground || is_riding || height_above_ground < 6 || fluid_depth_up > 2 || is_swimming, if(is_riding, torad(-90), if(is_swimming, left_leg.rx, (if(fluid_depth_up > 2 , sin(var.swing) * limb_speed + sin(time * 0.1) * 0.2, sin(var.swing) * limb_speed)) + if(limb_speed < 0.05, left_leg.rx, 0))), var.flightcontrol)))",
					"var.ll_ry": "if(is_gliding, left_leg.ry, if(death_time > 0, torad(90), left_leg.ry))",
					"var.ll_rz": "if(is_gliding, left_leg.rz, if(is_on_ground || is_riding, left_leg.rz + torad(hurt_time * -6), var.fall_rate * torad(-10) + left_leg.rz))",
					"var.rl_rx": "if(is_gliding, right_leg.rx, if(is_climbing, torad(-60) - sin(player_pos_y * 2.5) * 0.4, if(is_on_ground || is_riding || height_above_ground < 6 || fluid_depth_up > 2 || is_swimming, if(is_riding, torad(-90), if(is_swimming, right_leg.rx, (if(fluid_depth_up > 2, -(sin(var.swing) * limb_speed + sin(time * 0.1) * 0.2), -sin(var.swing) * limb_speed)) + if(limb_speed < 0.05, right_leg.rx, 0))), var.flightcontrol)))",
					"var.rl_ry": "if(is_gliding, right_leg.ry, if(death_time > 0, torad(90), right_leg.ry))",
					"var.rl_rz": "if(is_gliding, right_leg.rz, if(is_on_ground || is_riding, right_leg.rz + torad(hurt_time * 6), var.fall_rate * torad(10) + right_leg.rz))",
					"var.lh_rx": "if(death_time > 0, keyframe(death_time / 10, 0, torad(-50), torad(-180)), if(is_climbing, torad(-105) + sin(player_pos_y * 2.5) * 0.4, if(var.is_on_fire == 1, sin(-time * 0.6) * 0.8 * var.fall_rate, if(is_on_ground || height_above_ground < 6 || fluid_depth_up > 2, if(fluid_depth_up > 2 && is_holding_item_left == false && is_swimming == false, -sin(var.swing) * limb_speed + sin(time * 0.1) * 0.2, left_arm.rx), var.flightcontrol))))",
					"var.lh_ry": "if(death_time > 0, torad(90), if(fluid_depth_up > 2, torad(-5) + left_arm.ry, left_arm.ry))",
					"var.lh_rz": "if(var.is_on_fire == 1, torad(-150) + left_arm.rz, if(is_gliding, torad(-23), torad(hurt_time * -6) + if(var.jumping == 1, torad(-20) * clamp(height_above_ground * 0.4, 0, 1), left_arm.rz)))",
					"var.rh_rx": "if(death_time > 0, keyframe(death_time / 10, 0, torad(-50), torad(-180)), if(is_climbing, torad(-105) - sin(player_pos_y * 2.5) * 0.4, if(var.is_on_fire == 1, sin(time * 0.6) * 0.8 * var.fall_rate, if(is_on_ground || height_above_ground < 6 || fluid_depth_up > 2, if(fluid_depth_up > 2 && is_holding_item_right == false && is_swimming == false, sin(var.swing) * limb_speed + sin(time * 0.1) * 0.2, right_arm.rx), var.flightcontrol))))",
					"var.rh_ry": "if(death_time > 0, torad(90), if(fluid_depth_up > 2, torad(5) + right_arm.ry, right_arm.ry))",
					"var.rh_rz": "if(var.is_on_fire == 1, torad(150) + right_arm.rz, if(is_gliding, torad(23), torad(hurt_time * 6) + if(var.jumping == 1, torad(20) * clamp(height_above_ground * 0.4, 0, 1), right_arm.rz)))"
				},
				{
					"left_leg.tx": "if(is_in_gui, left_leg.tx, var.ll_tx)",
					"left_leg.ty": "if(is_in_gui, left_leg.ty, var.ll_ty)",
					"left_leg.tz": "if(is_in_gui, left_leg.tz, var.ll_tz)",
					"left_leg.rx": "if(is_in_gui, left_leg.rx, var.ll_rx)",
					"left_leg.ry": "if(is_in_gui, left_leg.ry, var.ll_ry)",
					"left_leg.rz": "if(is_in_gui, left_leg.rz, var.ll_rz)"
				},
				{
					"right_leg.tx": "if(is_in_gui, right_leg.tx, var.rl_tx)",
					"right_leg.ty": "if(is_in_gui, right_leg.ty, var.rl_ty)",
					"right_leg.tz": "if(is_in_gui, right_leg.tz, var.rl_tz)",
					"right_leg.rx": "if(is_in_gui, right_leg.rx, var.rl_rx)",
					"right_leg.ry": "if(is_in_gui, right_leg.ry, var.rl_ry)",
					"right_leg.rz": "if(is_in_gui, right_leg.rz, var.rl_rz)"
				},
				{
					"right_arm.rx": "if(is_first_person_hand || is_in_gui, right_arm.rx, var.rh_rx)",
					"right_arm.ry": "if(is_first_person_hand || is_in_gui, right_arm.ry, var.rh_ry)",
					"right_arm.rz": "if(is_first_person_hand || is_in_gui, right_arm.rz, var.rh_rz)",
					"right_arm.tx": "if(is_first_person_hand || is_in_gui, right_arm.tx, var.rh_tx)",
					"right_arm.ty": "if(is_first_person_hand || is_in_gui, right_arm.ty, var.rh_ty)",
					"right_arm.tz": "if(is_first_person_hand || is_in_gui, right_arm.tz, var.rh_tz)"
				},
				{
					"left_arm.rx": "if(is_first_person_hand || is_in_gui, left_arm.rx, var.lh_rx)",
					"left_arm.ry": "if(is_first_person_hand || is_in_gui, left_arm.ry, var.lh_ry)",
					"left_arm.rz": "if(is_first_person_hand || is_in_gui, left_arm.rz, var.lh_rz)",
					"left_arm.tx": "if(is_first_person_hand || is_in_gui, left_arm.tx, var.lh_tx)",
					"left_arm.ty": "if(is_first_person_hand || is_in_gui, left_arm.ty, var.lh_ty)",
					"left_arm.tz": "if(is_first_person_hand || is_in_gui, left_arm.tz, var.lh_tz)"
				},
				{
					"upperbody.rz": "-var.swing * 0.025",
					"upperbody.ry": "-var.shuffle * 0.017",
					"upperbody.ty": "if(is_on_ground, if(var.is_crouching == 1, var.idle_rate - 13.5, -12.25 + sin(limb_swing) * limb_speed * 0.9), upperbody.ty)",
					"upperbody.rx": "if((limb_speed > 0.05 && !is_swimming) || var.is_crouching == 1, if(var.is_crouching == 1, 0, torad(limb_speed * 8 * move_forward)), upperbody.rx)",
					"upperbody.tz": "if(var.is_crouching == 0, if(limb_speed > 0.05 && !is_swimming, limb_speed * -1.25 * move_forward, 0) + if(hurt_time == 10, 0, hurt_time * 0.05), 0)",
					"body.ry": "if(death_time > 0, torad(90), if(is_on_ground || is_riding || var.is_on_fire == 0, 0, var.fall_rate * sin(time * 0.75) * 0.1))",
					"body.rx": "if(var.is_crouching == 1, body.rx, if(limb_speed > 0.05 && !is_swimming, torad(limb_speed * 8 * move_forward), 0))",
					"body.tz": "if(var.is_crouching == 0, if(limb_speed > 0.05 && !is_swimming, limb_speed * -1.25 * move_forward, 0) + if(hurt_time == 10, 0, hurt_time * 0.05), 0)",
					"body.ty": "if(is_on_ground, if(limb_speed > 0.05 && !is_swimming && var.is_crouching == 0, if(is_gliding, body.ty, sin(limb_swing) * limb_speed * 0.9 + body.ty), var.idle_rate + body.ty), body.ty)",
					"jacket2.tz": "0.2",
					"jacket.ry": "if(is_on_ground || is_riding || var.is_on_fire == 0, 0, sin(time * 0.75) * 0.1)"
				},
				{
					"head.rx": "if(is_on_ground, if(is_swimming || is_gliding || is_crawling, torad(-65), if(hurt_time == 0, torad(-(3 + limb_speed * 2) + head_pitch) + sin(limb_swing) * limb_speed * 0.075, torad(head_pitch - 6 * hurt_time))), head.rx)",
					"head.rz": "if(is_crawling, head.rz, if(var.is_crouching == 0 && hurt_time == 10, torad(move_strafing * -17.5), 0))",
					"head.ry": "if(is_crawling, head.ry, if(is_swimming, -torad(head_yaw), torad(head_yaw)))",
					"head.tz": "if(var.is_crouching == 0, if(limb_speed > 0.05 && !is_swimming, limb_speed * -1.25 * move_forward, 0) + if(hurt_time == 10, 0, hurt_time * 0.05), 0)",
					"head.ty": "if(is_on_ground, if(limb_speed > 0.05 && !is_swimming && var.is_crouching == 0, if(is_gliding, head.ty, sin(limb_swing) * limb_speed * 0.9), var.idle_rate + head.ty), head.ty)"
				}
			]
		},
		{
			"part": "left_arm",
			"id": "left_arm",
			"invertAxis": "xy",
			"translate": [-5, -22, 0],
