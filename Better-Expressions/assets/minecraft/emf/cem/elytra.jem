{
	"credit": "Made with Blockbench",
	"texture": "",
	"textureSize": [64, 32],
	"models": [
		{
			"part": "right_wing",
			"id": "right_wing",
			"invertAxis": "xy",
			"mirrorTexture": "u",
			"translate": [-5, -24, 0],
			"textureSize": [64, 32],
			"boxes": [
				{"coordinates": [-5, 4, 0, 10, 20, 2], "textureOffset": [22, 0], "sizeAdd": 1}
			]
		},
		{
			"part": "left_wing",
			"id": "left_wing",
			"invertAxis": "xy",
			"translate": [5, -24, 0],
			"textureSize": [64, 32],
			"boxes": [
				{"coordinates": [-5, 4, 0, 10, 20, 2], "textureOffset": [22, 0], "sizeAdd": 1}
			],
			"animations": [
				{
					"var.is_crouching": "if(is_sneaking, 1, 0)",
					"var.idle_rate": "-sin(time * 0.075) * 0.3"
				},
				{
					"left_wing.ty": "if(is_gliding, 0, if(limb_speed > 0.05 && var.is_crouching == 0, if(is_on_ground, sin(limb_swing) * limb_speed * 0.9, left_wing.ty), var.idle_rate + left_wing.ty))",
					"right_wing.ty": "if(is_gliding, 0, if(limb_speed > 0.05 && var.is_crouching == 0, if(is_on_ground, sin(limb_swing) * limb_speed * 0.9, right_wing.ty), var.idle_rate + right_wing.ty))",
					"left_wing.tz": "if(limb_speed > 0.05, limb_speed * -1.25 * move_forward, 0)",
					"right_wing.tz": "if(limb_speed > 0.05, limb_speed * -1.25 * move_forward, 0)",
					"left_wing.rx": "if(is_swimming, 0, left_wing.rx)",
					"right_wing.rx": "if(is_swimming, 0, right_wing.rx)"
				}
			]
		}
	]
}
