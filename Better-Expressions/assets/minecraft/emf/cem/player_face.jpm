		{
			"var.JEface_header_enderman_eyes": 0,
			"var.JEface_eye_top10": "torad(head_pitch)/10 +clamp(2*clamp(-0.2 -cos(var.JEface_id+age/70)*2, 0, 1), 0, 0.3) +clamp(sin(var.JEface_id+age/38) +sin(var.JEface_id+age/13), -0.2, 0.2)*clamp(-20*2 -cos(var.JEface_id+age/125)*30*2, 0, 1)/2",
			"var.JEface_R_pupil10_x": "-0.5 -head_yaw/(80 +80*var.JEface_ylook) +(-sin(pi/4+var.JEface_id+age/10)*9 -0.3 )*clamp(var.JEface_nov1*4, 0, 1) +clamp(sin(var.JEface_id+age/27) +sin(var.JEface_id+age/16), -0.2, 0.2)*clamp(-20*2 -cos(var.JEface_id+age/125)*30*2, 0, 1)*clamp(59*4 -sin(var.JEface_id+age/187)*60*4, 0, 1)",
			"var.JEface_L_pupil10_x": "var.JEface_R_pupil10_x +1 +0.6*clamp(var.JEface_nov1*4, 0, 1)",
			"var.JEface_pupil10_y": "0.5 +clamp(head_pitch/(30 +200*var.JEface_ylook), -0.3, 0.5)  +(clamp(sin(var.JEface_id+age/38) +sin(var.JEface_id+age/13), -0.2, 0.2)*clamp(-20*2 -cos(var.JEface_id+age/125)*30*2, 0, 1) -clamp(-24 +sin(var.JEface_id+age/100)*40, 0, 1)/10 +clamp(2*clamp(-0.2 -cos(var.JEface_id+age/70)*2, 0, 1), 0, 0.3))",
			"var.JEface_blink10": "clamp( (1.5 -abs(sin(var.JEface_id+age/8)*6))*clamp(-32 +cos((var.JEface_id+age/8)/1.5)*40 +cos((var.JEface_id+age/8)/4)*40, 0, 1), var.JEface_eye_top10, 1 )"
		},
