{
	"id": "player_face",
	"textureSize": [64, 64],
	"animations": [
		{
			"var.JEface_id": "2 * pi * random(id)",
			"var.JEface_Bt": "age / (11 - random(id) * 2)",
			"var.JEface_ylook": "clamp( sin( var.JEface_id + age/60 ) * 6, 0, 1) * 1.2",
			"var.JEface_nov1": "clamp(-5.6 + cos(-pi/6 + var.JEface_id +    age/80) *  6, 0, 1) * clamp(2-limb_speed*4, 0, 1)",
			"var.JEface_nov2": "clamp( -39 + cos(-pi/4 + var.JEface_id + var.JEface_Bt/20) * 40, 0, 1) * clamp(1-limb_speed*2, 0, 1)",
			"var.JEface_eye_top": "clamp(head_pitch/60, -0.8, 0.5) +clamp(2*var.JEface_nov1, 0, 0.3) +(-1.5 -cos(limb_swing/3)/2)/4*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)",
			"var.JEface_pupils_x": "-head_yaw/(80 +160*var.JEface_ylook) -sin(pi/4+var.JEface_id+age/10)*3*clamp(var.JEface_nov1*4, 0, 1)",
			"var.JEface_R_pupil_x": " 0.5 +var.JEface_pupils_x -0.3*clamp(var.JEface_nov1*4, 0, 1)",
			"var.JEface_L_pupil_x": "-0.5 +var.JEface_pupils_x +0.3*clamp(var.JEface_nov1*4, 0, 1)",
			"var.JEface_pupil_y": "0.5 +clamp(head_pitch/80, -0.5, 0.5) +( -cos(var.JEface_id+var.JEface_Bt +sin(var.JEface_id+var.JEface_Bt) )/4 )*var.JEface_nov2 +clamp(2*var.JEface_nov1, 0, 0.3) + (-1 -cos(limb_swing/3)/2)*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0)",
			"var.JEface_blink": "clamp( (1.5 -abs(sin(var.JEface_id+age/8)*6))*clamp(-32 +cos((var.JEface_id+age/8)/1.5)*40 +cos((var.JEface_id+age/8)/4)*40, 0, 1), var.JEface_eye_top, 1 )"
		},
		{
			"var.JEface_LOD": "clamp( distance, 0, 128 )/1000",
			"2by1.sz": "1 +var.JEface_LOD*500",
			"2by2.sz": "1 +var.JEface_LOD*500",
			"2by3.sz": "1 +var.JEface_LOD*500",
			"3by1enderman.sz": "1 +var.JEface_LOD*500",
			"1by1simple.sz": "1 +var.JEface_LOD*250",
			"2by1farset.sz": "1 +var.JEface_LOD*500",
			"1by1_eyelid_only.sz": "1 +var.JEface_LOD*150",
			"1by2_eyelid_only.sz": "1 +var.JEface_LOD*150",
			"1by3_eyelid_only.sz": "1 +var.JEface_LOD*150",
			"eyelashes.tz": "-var.JEface_LOD",
			"brow_masks.sz": "1 +var.JEface_LOD*500",
			"brow_villager.tz": "-var.JEface_LOD*3",
			"r_brows.tz": "4 -var.JEface_LOD*2",
			"l_brows.tz": "4 -var.JEface_LOD*2",
			"r_brows_overlay.tz": "var.JEface_LOD",
			"l_brows_overlay.tz": "var.JEface_LOD",
			"var.JEface_head_addition": "-head_yaw/(80 +160*var.JEface_ylook)/2",
			"head.ry": "head.ry +var.JEface_head_addition"
		},
		{
			"var.JEface_header_2by1_standard": 0,
			"r_eye_white1.sy": "clamp(1 -var.JEface_eye_top, 0.5, 3)",
			"l_eye_white1.sy": "clamp(1 -var.JEface_eye_top, 0.5, 3)",
			"r_pupil1.tx": "clamp(var.JEface_R_pupil_x, -0.5, 0.5)",
			"l_pupil1.tx": "clamp(var.JEface_L_pupil_x, -0.5, 0.5)",
			"r_pupil1.ty": "clamp(var.JEface_pupil_y, var.JEface_eye_top, 1)",
			"l_pupil1.ty": "clamp(var.JEface_pupil_y, var.JEface_eye_top, 1)",
			"r_pupil_up1.sy": "clamp(1 -(var.JEface_pupil_y-0.5), 0.5, clamp(1-var.JEface_eye_top, 0.5, 1))",
			"l_pupil_up1.sy": "clamp(1 -(var.JEface_pupil_y-0.5), 0.5, clamp(1-var.JEface_eye_top, 0.5, 1))",
			"r_pupil_do1.sy": "clamp(1 +(var.JEface_pupil_y-0.5) -var.JEface_eye_top, 0.5, 1)",
			"l_pupil_do1.sy": "clamp(1 +(var.JEface_pupil_y-0.5) -var.JEface_eye_top, 0.5, 1)",
			"r_pupil_in1.sx": "clamp(1 -(var.JEface_R_pupil_x-0.5), 0.75, 1)",
			"l_pupil_ou1.sx": "clamp(1 +(var.JEface_L_pupil_x+0.5), 0.75, 1)",
			"r_blink1.sy": "var.JEface_blink",
			"l_blink1.sy": "var.JEface_blink",
			"r_eyelid1.sy": "clamp(r_eye_white1.sy, 1, 4)",
			"l_eyelid1.sy": "clamp(l_eye_white1.sy, 1, 4)",
			"r_eyelid1.visible": "r_eyelid1.sy>0 && r_blink1.sy>0",
			"l_eyelid1.visible": "l_eyelid1.sy>0 && l_blink1.sy>0",
