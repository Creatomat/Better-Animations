		{
			"eyelashes.sy": "clamp(1 -var.JEface_eye_top, 1, 1.5)",
			"brow_villager.ty": "-0.5 + clamp( 1 -sin(var.JEface_id+age /110)*4, -0.3, 0 ) + clamp(head_pitch/30*(1 -2*clamp(sin(var.JEface_id+age/73)*3, 0, 1)), -0.8, -0.3*clamp(sin(var.JEface_id+age/73)*3, 0, 1))*1.2 +(clamp(-torad(head_yaw)/2, -0.5, 0) +clamp( torad(head_yaw)/2, -0.5, 0))*clamp(-sin(var.JEface_id+age/80)*6, 0, 1) -sin(hurt_time*pi/10)*(1.5 +sin(limb_swing/3)) +( cos(-pi/3 +var.JEface_id+var.JEface_Bt )/1.5 -0.1 )*var.JEface_nov2 - 0.2*var.JEface_nov1",
			"brow_villager.rz": "torad( clamp(head_yaw/9, -10, 10) * (0.3+0.7*random(id))) * clamp(-sin(var.JEface_id+age/80)*6, 0, 1) - sin(limb_swing/1.5) / 6 * if(is_hurt, - sin(hurt_time*pi/5)/6*hurt_time, 0)",
			"var.JEface_brows_y": "28 +clamp(-sin(var.JEface_id+age /110)*4, -0.3, 0) +clamp(head_pitch/60, -0.8, 0.5)*0.75 +( cos(-pi/3 +var.JEface_id+var.JEface_Bt )/1.5 -0.1 )*var.JEface_nov2*0.5 -0.2*var.JEface_nov1",
			"r_brows.ty": "var.JEface_brows_y +clamp(-torad(head_yaw)/2, -0.5, 0.2)*clamp(-sin(var.JEface_id+age/90)*6, 0, 1)*(0.6+0.4*var.JEface_ylook*random(id)) +(-1 +sin(-var.JEface_id)/3)/4*clamp(-4 +sin(var.JEface_id +age/97)*8, 0, 1)*random(id) -sin(hurt_time*pi/10)*(1.5 +sin(limb_swing/3))",
			"l_brows.ty": "var.JEface_brows_y +clamp( torad(head_yaw)/2, -0.5, 0.2)*clamp(-sin(var.JEface_id+age/90)*6, 0, 1)*(0.6+0.4*var.JEface_ylook*random(id)) +(-1 +cos(-var.JEface_id)/3)/4*clamp(-4 +sin(var.JEface_id +age/97)*8, 0, 1)*random(id) -sin(hurt_time*pi/10)*(1.5 -sin(limb_swing/3))"
		}
	],
