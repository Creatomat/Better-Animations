    "head.ty": "if(is_on_ground, if(limb_speed > 0.05 && !is_swimming && var.is_crouching == 0, if(is_gliding, head.ty, if(var.is_flying == 1, 0, sin(limb_swing) * limb_speed * 0.9)), if(var.is_flying == 1, head.ty, var.idle_rate + head.ty)), head.ty)"
