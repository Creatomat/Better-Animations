			"animations": [
 {
    "var.random": "random(time)",
    "var.vert_speed": "clamp(var.pos_y - player_pos_y, 0, 1)",
    "var.moving": "if(var.pos_y != player_pos_y, 1, 0)",
    "var.moving_up": "if(var.pos_y < player_pos_y, 1, 0)",
    "var.moving_down": "if(var.pos_y > player_pos_y, 0, 0)",
    "var.shuffle": "clamp(cos(limb_swing * -0.725) * limb_speed, -1, 1)",
    "var.leg": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 0)",
    "var.swing": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 1)",
    "var.fakeswing": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 1)",
    "var.is_flying": "if(var.vert_speed != 0 || is_on_ground || height_above_ground < 3, 0, 0)",
    "var.is_crouching": "if(is_sneaking, 1, 0)",
    "var.is_on_fire": "if(((height_above_ground > 6 && !is_on_ground && !is_gliding && var.moving_down == 1 && var.vert_speed > 0.45 && !is_riding && !is_in_water && !is_climbing) || is_burning) && !is_blocking, 1, 0)",
    "var.is_falling": "if(var.is_on_fire == 1 && height_above_ground > 6 && var.moving_down == 1, 1, 0)",
    "var.idle_rate": "-sin(time * 0.075) * 0.3",
    "var.fall_rate": "clamp(height_above_ground*0.3, 0, 0.8)",
    "var.a": "0",
    "var.b": "0",
    "var.c": "0",
    "var.d": "0",
    "var.jumping": "if(height_above_ground > 1 && !is_in_water && !is_on_ground, 1, 0)",
	"var.flightcontrol": "torad(20 * move_forward * limb_speed)",
	"var.pos_y": "player_pos_y"
  },
  {
    "var.ll_tx": "2.1 + if(death_time > 0, -2, 0)",
    "var.ll_ty": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming, left_leg.ty, var.leg * 3.2 + 11.95), var.leg * 3.2 + 11.95 + 0.75), 11.95)",
    "var.ll_tz": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming || fluid_depth_up > 2, if(is_swimming, left_leg.tz, 0), -var.shuffle * 2.25), -var.shuffle * 2.25 + 4.5) + if(death_time > 0, -2, 0), left_leg.tz)",
    "var.rl_tx": "-2.1 + if(death_time > 0, 2, 0)",
    "var.rl_ty": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming, right_leg.ty, -var.leg * 3.2 + 11.95 + limb_speed * -1.6), -var.leg * 3.2 + 11.95 + 0.75), 11.95)",
    "var.rl_tz": "if(is_on_ground, if(var.is_crouching == 0, if(is_swimming || fluid_depth_up > 2, if(is_swimming, right_leg.tz, 0), var.shuffle * 2.25), var.shuffle * 2.25 + 4.5) + if(death_time > 0, 2, 0), right_leg.tz)",
    "var.lh_tx": "left_arm.tx + if(death_time > 0, -5, 0)",
    "var.lh_ty": "if(is_on_ground, if(is_gliding, left_arm.ty, var.idle_rate + left_arm.ty + sin(limb_swing) * limb_speed * 0.9), left_arm.ty)",
    "var.lh_tz": "if(limb_speed > 0.05 && !is_swimming, limb_speed * -1.25, left_arm.tz) + if(death_time > 0, -5, 0)",
    "var.rh_tx": "right_arm.tx + if(death_time > 0, 5, 0)",
    "var.rh_ty": "if(is_on_ground, if(is_gliding, right_arm.ty, var.idle_rate + right_arm.ty + sin(limb_swing) * limb_speed * 0.9), right_arm.ty",
    "var.rh_tz": "if(limb_speed > 0.05 && !is_swimming, limb_speed * -1.25, right_arm.tz) + if(death_time > 0, 5, 0)"
  },
  {
    "var.ll_rx": "if(is_gliding, left_leg.rx, if(is_climbing, torad(-60) + sin(player_pos_y*2.5)*0.4, if(is_on_ground || is_riding || height_above_ground < 6 || fluid_depth_up > 2 || is_swimming, if(is_riding, torad(-90), if(is_swimming, left_leg.rx, if(!is_gliding, if(fluid_depth_up > 2, sin(var.fakeswing) * limb_speed + sin(time * 0.1) * 0.2, sin(var.fakeswing) * limb_speed), sin(var.fakeswing) * limb_speed * 0.175) + if(limb_speed < 0.05, left_leg.rx, 0))), var.flightcontrol)) + var.d)",
    "var.ll_ry": "if(is_gliding, left_leg.ry, if(death_time > 0, torad(90), if(is_on_ground || is_riding || var.is_falling == 0, left_leg.ry, var.fall_rate * torad(-10) + left_leg.ry)))",
    "var.ll_rz": "if(is_gliding, left_leg.rz, if(is_on_ground || is_riding, if(is_swimming, sin(limb_swing * 0.24) * 0.4 + torad(-30), if(fluid_depth_up > 2, torad(-7) + left_leg.rz, left_leg.rz + torad(hurt_time * -6))), var.fall_rate * torad(-10) + left_leg.rz))",
    "var.rl_rx": "if(is_gliding, right_leg.rx, if(is_climbing, torad(-60)  + -sin(player_pos_y*2.5)*0.4, if(is_on_ground || is_riding || height_above_ground < 6 || fluid_depth_up > 2 || is_swimming, if(is_riding, torad(-90), if(is_swimming, right_leg.rx, if(!is_gliding, if(fluid_depth_up > 2, -(sin(var.fakeswing) * limb_speed + sin(time * 0.1) * 0.2), -(sin(var.fakeswing) * limb_speed)), -(sin(var.fakeswing) * limb_speed * 0.175)) + if(limb_speed < 0.05, right_leg.rx, 0))), var.flightcontrol)) + var.c)",
    "var.rl_ry": "if(is_gliding, right_leg.ry, if(death_time > 0, torad(90), if(is_on_ground || is_riding || var.is_falling == 0, right_leg.ry, var.fall_rate * torad(10) + right_leg.ry)))",
    "var.rl_rz": "if(is_gliding, right_leg.rz, if(is_on_ground || is_riding, if(is_swimming, sin(limb_swing * 0.24) * -0.4 + torad(30), if(fluid_depth_up > 2, torad(7) + right_leg.rz, right_leg.rz + torad(hurt_time * 6))), var.fall_rate * torad(10) + right_leg.rz))",
    "var.lh_rx": "if(death_time > 0, keyframe(death_time / 10, 0, torad(-50), torad(-180)), if(is_climbing, torad(-105) + sin(player_pos_y*2.5)*0.4, if(var.is_on_fire == 1, sin(-time * 0.6) * 0.8 * var.fall_rate, if(is_on_ground || height_above_ground < 6, left_arm.rx, if(fluid_depth_up > 2, left_arm.rx, var.flightcontrol)))) + var.b)",
    "var.lh_ry": "if(death_time > 0, torad(90), if(fluid_depth_up > 2, torad(-15) + left_arm.ry, left_arm.ry))",
    "var.lh_rz": "if(var.is_on_fire == 1, if(var.is_falling == 1, torad(-150) * var.vert_speed + left_arm.rz, torad(-150) + left_arm.rz), if(is_gliding, torad(-23), torad(hurt_time * -6) + if(var.jumping == 1, torad(-20) * clamp(height_above_ground * 0.4, 0, 1), left_arm.rz)))",
    "var.rh_rx": "if(death_time > 0, keyframe(death_time / 10, 0, torad(-50), torad(-180)), if(is_climbing, torad(-105) + -sin(player_pos_y*2.5)*0.4, if(var.is_on_fire == 1, (sin(time * 0.6) * 0.8) * var.fall_rate, if(is_on_ground || height_above_ground < 6, right_arm.rx, if(fluid_depth_up > 2, right_arm.rx, var.flightcontrol)))) + var.a)",
    "var.rh_ry": "if(death_time > 0, torad(90), if(fluid_depth_up > 2, torad(15) + right_arm.ry, right_arm.ry))",
    "var.rh_rz": "if(var.is_on_fire == 1, if(var.is_falling == 1, torad(150) * var.vert_speed + right_arm.rz, torad(150) + right_arm.rz), if(is_gliding, torad(23), torad(hurt_time * 6) + if(var.jumping == 1, torad(20) * clamp(height_above_ground * 0.4, 0, 1), right_arm.rz)))"
  },
  {
    "left_leg.tx": "if(var.is_flying == 1, 2.1, if(is_in_gui, left_leg.tx, var.ll_tx))",
    "left_leg.ty": "if(var.is_flying == 1, 11.95, if(is_in_gui, left_leg.ty, var.ll_ty))",
    "left_leg.tz": "if(var.is_flying == 1, 0, if(is_in_gui, left_leg.tz, var.ll_tz))",
    "left_leg.rx": "if(var.is_flying == 1, 0, if(is_in_gui, left_leg.rx, var.ll_rx))",
    "left_leg.ry": "if(var.is_flying == 1, 0, if(is_in_gui, left_leg.ry, var.ll_ry))",
    "left_leg.rz": "if(var.is_flying == 1, torad(-6), if(is_in_gui, left_leg.rz, var.ll_rz))"
  },
  {
    "right_leg.tx": "if(var.is_flying == 1, -2.1, if(is_in_gui, right_leg.tx, var.rl_tx))",
