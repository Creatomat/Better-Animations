    "right_leg.rz": "if(var.is_flying == 1, torad(6), if(is_in_gui, right_leg.rz, var.rl_rz))"
  },
  {
    "right_arm.rx": "if(var.is_flying == 1, if(is_holding_item_right, right_arm.rx, 0), if(is_first_person_hand || is_in_gui, right_arm.rx, var.rh_rx))",
    "right_arm.rz": "if(var.is_flying == 1, if(is_holding_item_right, right_arm.rz, torad(10)), if(is_first_person_hand || is_in_gui, right_arm.rz, var.rh_rz))",
    "right_arm.ry": "if(var.is_flying == 1, if(is_holding_item_right, right_arm.ry, 0), if(is_first_person_hand || is_in_gui, right_arm.ry, var.rh_ry))",
