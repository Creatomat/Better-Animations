  {
    "head.rx": "if(is_on_ground, if(is_swimming || is_gliding || is_crawling, torad(-65), if(hurt_time == 0, torad(-(3 + (limb_speed * 2)) + head_pitch) + torad(-6 * hurt_time) + if(var.is_flying == 1, 0, sin(limb_swing) * limb_speed * 0.075), torad(head_pitch + (-6 * hurt_time)))), head.rx)",
    "head.rz": "if(is_crawling, head.rz, if(var.is_crouching == 0 && hurt_time == 10, torad(move_strafing * -17.5), 0))",
