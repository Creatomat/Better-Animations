    "upperbody.rx": "if((limb_speed > 0.05 && !is_swimming) || var.is_crouching == 1, if(var.is_crouching == 1, 0, torad(limb_speed * 8)), upperbody.rx)",
    "upperbody.tz": "if(var.is_crouching == 0, if(limb_speed > 0.05 && !is_swimming, (limb_speed * -1.25) + if(hurt_time == 10, 0, hurt_time * 0.05), if(hurt_time == 10, 0, hurt_time * 0.05)), 0)",
