{
	"credit": "Made with Blockbench",
	"texture": "",
	"textureSize": [64, 32],
	"models": [
		{
			"part": "right_wing",
			"id": "right_wing",
			"invertAxis": "xy",
			"mirrorTexture": "u",
			"translate": [-5, -24, 0],
			"textureSize": [64, 32],
			"boxes": [
				{"coordinates": [-5, 4, 0, 10, 20, 2], "textureOffset": [22, 0], "sizeAdd": 1}
			]
		},
		{
			"part": "left_wing",
			"id": "left_wing",
			"invertAxis": "xy",
			"translate": [5, -24, 0],
			"textureSize": [64, 32],
			"boxes": [
				{"coordinates": [-5, 4, 0, 10, 20, 2], "textureOffset": [22, 0], "sizeAdd": 1}
			],
			"animations": [
				{
					"var.random": "random(time)",
					"var.vert_speed": "clamp(var.pos_y - player_pos_y, 0, 1)",
					"var.moving": "if(var.pos_y != player_pos_y, 1, 0)",
					"var.moving_up": "if(var.pos_y < player_pos_y, 1, 0)",
					"var.moving_down": "if(var.pos_y > player_pos_y, 0, 0)",
					"var.shuffle": "clamp(cos(limb_swing * -0.725) * limb_speed, -1, 1)",
					"var.leg": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 0)",
					"var.swing": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 1)",
					"var.fakeswing": "clamp(sin(limb_swing * 0.725) * limb_speed, -1, 1)",
					"var.is_flying": "if(var.vert_speed != 0 || is_on_ground || height_above_ground < 3, 0, 0)",
					"var.is_crouching": "if(is_sneaking, 1, 0)",
					"var.is_on_fire": "if(((height_above_ground > 6 && !is_on_ground && !is_gliding && var.moving_down == 1 && var.vert_speed > 0.45 && !is_riding && !is_in_water && !is_climbing) || is_burning) && !is_blocking, 1, 0)",
					"var.is_falling": "if(var.is_on_fire == 1 && height_above_ground > 6 && var.moving_down == 1, 1, 0)",
					"var.idle_rate": "-sin(time * 0.075) * 0.3",
					"var.fall_rate": "if(var.moving_down == 0, 0.5, var.vert_speed)",
					"var.a": "0",
					"var.b": "0",
					"var.c": "0",
					"var.d": "0",
					"var.jumping": "if(height_above_ground > 1 && !is_in_water && !is_on_ground, 1, 0)",
					"var.flightcontrol": "torad(20 * move_forward * limb_speed)",
					"var.pos_y": "player_pos_y"
				},
				{
					"left_wing.ty": "if(is_gliding == true, 0, if(limb_speed > 0.05 && var.is_crouching == 0,if(is_on_ground, sin(limb_swing*1)*limb_speed*0.9, left_wing.ty),(var.idle_rate) + left_wing.ty))",
					"right_wing.ty": "if(is_gliding == true, 0, if(limb_speed > 0.05 && var.is_crouching == 0,if(is_on_ground, sin(limb_swing*1)*limb_speed*0.9, left_wing.ty),(var.idle_rate) + right_wing.ty))",
					"left_wing.tz": "if(limb_speed > 0.05, (limb_speed * -1.25 * move_forward), 0)",
					"right_wing.tz": "if(limb_speed > 0.05, (limb_speed * -1.25 * move_forward), 0)",
					"left_wing.rx": "if(is_swimming == true, 0, left_wing.rx)",
					"right_wing.rx": "if(is_swimming == true, 0, right_wing.rx)"
				}
			]
		}
	]
}
